# Copy to backend/.env for local development. Never commit real values.
CWY_APP_NAME="Claim What's Yours API"
CWY_ENVIRONMENT=development
CWY_API_PREFIX=/api/v1
CWY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/claim_whats_yours
CWY_DATABASE_CONNECT_TIMEOUT_SECONDS=3
CWY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Authentication (optional locally; see docs for setup)
# CWY_FIREBASE_PROJECT_ID=your-firebase-project-id
# CWY_FIREBASE_CREDENTIALS_PATH=C:\path\to\service-account.json   (never commit this file)

